# PostgreSQL Database Password
# For production, generate with: openssl rand -base64 32
DB_PASSWORD=your_secure_password_here

# Nakama Session Key (used for JWT token signing)
# For production, generate with: openssl rand -base64 32
SESSION_KEY=your_secure_session_key_here

# Nakama Server URL for Flutter app
# Local development: http://localhost:7351
# Production: https://your-domain.com:7351
NAKAMA_SERVER_URL=http://localhost:7351
